              "zeilen": [
                [
                  "Aufbewahrungsfrist",
                  "Zeitraum, in dem eine Unterlage vorhanden sein muss; er beginnt mit dem Ende des Kalenderjahres ihrer Entstehung (§ 147 Abs. 3 und 4 AO)."
                ],
                [
                  "Auftragsverarbeiter",
                  "Dienstleister, der personenbezogene Daten im Auftrag und nach Weisung des Unternehmens verarbeitet (Art. 4 Nr. 8, Art. 28 DSGVO)."
                ],
                [
                  "Beleg",
                  "Nachweis eines Geschäftsvorfalls, etwa eine Rechnung oder Quittung; er begründet die Buchung (GoBD Rz. 61 ff.)."
                ],
                [
                  "E-Rechnung",
                  "Rechnung in einem strukturierten elektronischen Format wie XRechnung oder ZUGFeRD, das sich maschinell auswerten lässt (§ 14 Abs. 1 UStG)."
                ],
                [
                  "Geschäftsbrief",
                  "Schreiben, mit dem ein Geschäft vorbereitet, abgeschlossen, abgewickelt oder rückgängig gemacht wird, etwa ein Angebot oder eine Auftragsbestätigung (§ 147 Abs. 1 Nr. 2 und 3 AO)."
                ],
                [
                  "GoBD",
                  "Verwaltungsanweisung des Bundesfinanzministeriums dazu, wie Bücher und Unterlagen elektronisch zu führen und aufzubewahren sind (BMF-Schreiben vom 28.11.2019, Fassung vom 14.07.2025)."
                ],
                [
                  "Internes Kontrollsystem",
                  "Gesamtheit der Regeln und Kontrollen, die dafür sorgen, dass Vorgänge vollständig und richtig erfasst werden (GoBD Rz. 100 bis 102)."
                ],
                [
                  "Unveränderbarkeit",
                  "Einmal erfasste Informationen dürfen nicht ohne Kenntlichmachung geändert oder gelöscht werden (§ 146 Abs. 4 AO, GoBD Rz. 107 ff.)."
                ],
                [
                  "Verfahrensdokumentation",
                  "Beschreibung, wie Unterlagen entstehen, verarbeitet, aufbewahrt und wiedergegeben werden, so dass sachverständige Dritte das Verfahren nachvollziehen können (GoBD Rz. 151 bis 155)."
                ],
                [
                  "Vier-Augen-Prinzip",
                  "Eine zweite Person prüft oder gibt frei, was eine erste erstellt hat; so fallen Fehler und Missbrauch eher auf (GoBD Rz. 100)."
                ]
              ]

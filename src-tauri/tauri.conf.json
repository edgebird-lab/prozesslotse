{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Prozesslotse",
  "mainBinaryName": "prozesslotse",
  "version": "../package.json",
  "identifier": "de.olbricht-digital.prozesslotse",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Prozesslotse",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Robin Olbricht",
    "category": "Business",
    "shortDescription": "Geschäftsprozesse geführt modellieren, als BPMN zeichnen und verbessern",
    "copyright": "© 2026 Robin Olbricht",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["prozesslotse"],
        "name": "Prozesslotse.Projekt",
        "description": "Prozesslotse-Projekt",
        "mimeType": "application/vnd.prozesslotse+json",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "compression": "lzma",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
